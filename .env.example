# Copy to .env before running. No real secrets belong in this file or in git.

APP_ENV=local
APP_DEBUG=true

# Database (MySQL 8). The docker compose service name is "db".
DB_HOST=db
DB_PORT=3306
DB_NAME=catalog
DB_USER=catalog
DB_PASSWORD=change-me-locally

# The single service API key callers must send as: X-Api-Key: <value>
# Generate your own with: openssl rand -hex 32
API_KEY=change-me-locally

# How long a cached product stays fresh before it is re-fetched from the source.
PRODUCT_CACHE_TTL_SECONDS=900

# Token bucket per source operation: burst size and refill rate.
SOURCE_RATE_BURST=10
SOURCE_RATE_REFILL_PER_SECOND=2

# Mock marketplace behaviour, so the throttling and partial-failure paths are
# reachable without a real marketplace account.
MOCK_THROTTLE_RATE=0.15
MOCK_ROW_REJECT_RATE=0.10
MOCK_JOB_COMPLETE_AFTER_SECONDS=5
