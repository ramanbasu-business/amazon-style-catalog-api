{
    "name": "ramanbasu/catalog-api",
    "description": "Read-through catalog API over a pluggable marketplace product source.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "doctrine/dbal": "^4.0",
        "monolog/monolog": "^3.6",
        "vlucas/phpdotenv": "^5.6",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Catalog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Catalog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "lint": "phpcs",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
